# -------------------------------------------------------------
# MULTI-PROVIDER AI WATERFALL ROUTER (Order: 9 -> 8 -> 7 -> 6 -> 5 -> 4 -> 3 -> 2 -> 1)
# Backend executes providers in reverse order (Open Source / Free tier first down to Gemini)
# -------------------------------------------------------------

# Provider 9: Hugging Face (Open Source / Inference API)
HF_TOKEN=

# Provider 8: Cloudflare Workers AI
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Provider 7: OpenRouter (DeepSeek / Llama / Qwen Free Models)
OPENROUTER_API_KEY=

# Provider 6: Mistral AI (Pixtral Vision & Mistral Small)
MISTRAL_API_KEY=

# Provider 5: SambaNova Cloud (Llama 3.2 Vision & 70B)
SAMBANOVA_API_KEY=

# Provider 4: Cerebras (High-Speed Llama 3.3 Text Inference)
CEREBRAS_API_KEY=

# Provider 3: NVIDIA NIM (NVIDIA Hosted Llama 3.2 Vision)
NVIDIA_API_KEY=

# Provider 2: Groq (Ultra-Fast LPU Llama 3.2 Vision & 70B)
GROQ_API_KEY=

# Provider 1: Google Gemini (Gemini 2.5 Flash / 3.1 Flash Lite)
GEMINI_API_KEY=

# Application URL (Auto-injected in production)
APP_URL=

